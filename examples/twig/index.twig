{#
    resources/views/wasabi/index.twig  (TwigBridge resolves view("wasabi.index") to this file)

    Twig in Laravel via TwigBridge:  composer require rcrowe/twigbridge
    TwigBridge exposes Laravel helpers such as route(), csrf_token(), session() and method_field().
    Presigned URLs are generated in the controller (WasabiFileController::index), so no
    storage logic lives in the template.
#}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="csrf-token" content="{{ csrf_token() }}">
    <title>Wasabi files</title>
</head>
<body>
    {% if session('status') %}
        <p role="status">{{ session('status') }}</p>
    {% endif %}

    {# 1. Classic upload: browser -> Laravel -> Wasabi #}
    <h2>Upload through Laravel</h2>
    <form method="POST" action="{{ route('wasabi.store') }}" enctype="multipart/form-data">
        <input type="hidden" name="_token" value="{{ csrf_token() }}">
        <input type="file" name="file" required>
        <button type="submit">Upload</button>
    </form>

    {# 2. Direct upload: browser -> Wasabi with a presigned URL (needs bucket CORS) #}
    <h2>Direct upload to Wasabi</h2>
    <input type="file" id="direct-file"
           data-presign-url="{{ route('wasabi.presign') }}"
           data-confirm-url="{{ route('wasabi.confirm') }}">
    <progress id="direct-progress" value="0" max="100" hidden></progress>
    <p id="direct-status"></p>

    <h2>Your files</h2>
    <ul>
        {% for file in files %}
            <li>
                {# Presigned link: valid 15 minutes, works on private buckets #}
                <a href="{{ file.url }}" target="_blank" rel="noopener">{{ file.name }}</a>
                ({{ (file.size / 1024)|number_format(1) }} KB)

                {% if file.name|lower matches '/\\.(jpe?g|png|webp|gif)$/' %}
                    <img src="{{ file.url }}" alt="" width="80" loading="lazy">
                {% endif %}

                <a href="{{ route('wasabi.download', {key: file.key}) }}">Download</a>

                <form method="POST" action="{{ route('wasabi.destroy', {key: file.key}) }}" style="display:inline">
                    <input type="hidden" name="_token" value="{{ csrf_token() }}">
                    <input type="hidden" name="_method" value="DELETE">
                    <button type="submit">Delete</button>
                </form>
            </li>
        {% else %}
            <li>No files yet.</li>
        {% endfor %}
    </ul>

    <script>
        const input = document.getElementById('direct-file');
        const csrf = document.querySelector('meta[name="csrf-token"]').content;
        const post = (url, body) => fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-CSRF-TOKEN': csrf },
            body: JSON.stringify(body),
        }).then(r => r.ok ? r.json() : Promise.reject(r));

        input.addEventListener('change', async () => {
            const file = input.files[0];
            if (!file) return;

            const progress = document.getElementById('direct-progress');
            const type = file.type || 'application/octet-stream';

            try {
                const { key, url, headers } = await post(input.dataset.presignUrl, { name: file.name, type, size: file.size });

                progress.hidden = false;
                await new Promise((resolve, reject) => {
                    const xhr = new XMLHttpRequest();
                    xhr.open('PUT', url);
                    Object.entries(headers).forEach(([name, value]) => xhr.setRequestHeader(name, value));
                    xhr.setRequestHeader('Content-Type', type);
                    xhr.upload.onprogress = (e) => { if (e.lengthComputable) progress.value = (e.loaded / e.total) * 100; };
                    xhr.onload = () => (xhr.status < 300 ? resolve() : reject(new Error(`Wasabi: HTTP ${xhr.status}`)));
                    xhr.onerror = () => reject(new Error('Network/CORS error. Check the bucket CORS configuration.'));
                    xhr.send(file);
                });

                await post(input.dataset.confirmUrl, { key });
                window.location.reload();
            } catch (error) {
                document.getElementById('direct-status').textContent = error.message ?? 'Upload failed.';
            }
        });
    </script>
</body>
</html>
