{
    "name": "siberfx/flysystem-wasabi",
    "description": "Wasabi Hot Cloud Storage filesystem driver for Laravel 12 and 13 (Flysystem v3).",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "wasabi", "s3", "flysystem", "storage", "filesystem"],
    "homepage": "https://github.com/siberfx/flysystem-wasabi",
    "authors": [
        {
            "name": "Selim Görmüş",
            "email": "info@siberfx.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "aws/aws-sdk-php": "^3.337",
        "illuminate/filesystem": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "league/flysystem": "^3.25",
        "league/flysystem-aws-s3-v3": "^3.25"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.8|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Siberfx\\WasabiStorage\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Siberfx\\WasabiStorage\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest --exclude-group=integration",
        "test:integration": "pest --group=integration"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Siberfx\\WasabiStorage\\WasabiServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
